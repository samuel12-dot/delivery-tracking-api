{
  "name": "delivery-tracking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented delivery tracking API with PostGIS and Redis",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "node-pg-migrate": "^8.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
